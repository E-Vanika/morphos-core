# Backend Environment Variables
# Set these in GitHub Secrets for production
# See README.md for detailed setup instructions

# ============================================
# REQUIRED: Gemini API & AI Configuration
# ============================================
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
LOG_LEVEL=INFO

# ============================================
# REQUIRED: Supabase Database Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# REQUIRED: Domain & Authentication
# ============================================
# Comma-separated emails allowed to manage knowledge & services
ADMIN_EMAILS=admin@example.com,you@example.com

# MCP API Key for machine-to-machine access (at least 32 chars)
# Generate: openssl rand -hex 16
MCP_API_KEY=generate_a_long_random_token_for_mcp_clients_12345678

# ============================================
# REQUIRED: CORS Configuration
# ============================================
# Comma-separated domains allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.vercel.app

# ============================================
# OPTIONAL: Domain Preset
# ============================================
# Default domain profile if not specified in requests
# Options: professional-services, healthcare, art-craft, bridal-makeup
DOMAIN_PRESET=professional-services

# ============================================
# OPTIONAL: Storage Bucket Names
# ============================================
# Supabase Storage bucket IDs for gallery images
CRAFTS_BUCKET=Art and craft
BRIDAL_BUCKET=Monika glamup

# ============================================
# LOCAL DEVELOPMENT ONLY
# ============================================
# For local testing with `vercel dev` or direct uvicorn
# Do NOT commit secrets to repository

