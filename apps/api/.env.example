# Monika Glam Up API configuration
# Copy to a local, ignored environment file or add these as deployment secrets.

# Required for enquiry and review storage.
# Create this endpoint with docs/google-sheets-apps-script.gs and keep the key private.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec?key=LONG_RANDOM_SECRET

# Recommended: powers the public bridal concierge.
GEMINI_API_KEY=

# Recommended: protects /api/mcp and /api/v1/skills.
MCP_API_KEY=

# Browser origins allowed to call the API directly.
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.vercel.app
LOG_LEVEL=INFO
DOMAIN_PRESET=bridal-makeup

# Optional: private alert after Google Sheets confirms an enquiry save.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional legacy features only. The Monika enquiry, review, pricing and gallery
# pages do not require a Supabase database connection.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
CRAFTS_BUCKET=Art and craft
BRIDAL_BUCKET=Monika glamup
